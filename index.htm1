<!DOCTYPE html>
<html>
<head>
    <title>SmartOddsAI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial;
            margin: 0;
            background: #0b0f1a;
            color: white;
            text-align: center;
        }

        header {
            background: #111827;
            padding: 20px;
            font-size: 24px;
            font-weight: bold;
        }

        .container {
            padding: 20px;
        }

        .box {
            background: #1f2937;
            margin: 15px;
            padding: 20px;
            border-radius: 10px;
        }

        button {
            background: #22c55e;
            border: none;
            padding: 12px 20px;
            color: white;
            font-size: 16px;
            border-radius: 5px;
        }
    </style>
</head>

<body>

<header>🔥 SmartOddsAI VIP Tips</header>

<div class="container">

    <div class="box">
        <h2>🎯 Free Daily Tip</h2>
        <p>Arsenal vs Chelsea — Over 2.5 Goals</p>
    </div>

    <div class="box">
        <h2>💎 VIP Tips</h2>
        <p>Unlock today’s high odds games</p>
        <button>Join VIP</button>
    </div>

</div>

</body>
</html>
